# Secure Connection Variables
# Ensure this file is never committed to version control.
# Copy to .env for local development

# ----------------------------------------
# 1. Primary Database Connection (PostgreSQL)
# ----------------------------------------
# Replace with your production DB URI (e.g., AWS RDS, Neon, Supabase Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/braveheart_crm?sslmode=require

# Optional read-replica for reporting / metrics
RO_DATABASE_URL=postgresql://user:password@localhost:5432/braveheart_crm_replica?sslmode=require

# ----------------------------------------
# 2. Redis Connection (Optional, for Rate Limiting / Caching)
# ----------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------
# 3. Third-party APIs & Secrets
# ----------------------------------------
# Gemini API Key (Server-side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Outbound Dialer Webhook Secret
DIALER_WEBHOOK_SECRET=your_secret_here

# Session / JWT Secret for Authentication Verification
JWT_SECRET=super_secret_jwt_signature_key
